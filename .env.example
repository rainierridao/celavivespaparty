PORT=8080
AUTH_SECRET=replace_with_a_long_random_secret

# Storage
DATA_BACKEND=firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT_FILE=./service-account.json

# Google Sheets (optional, only when DATA_BACKEND is not firebase)
GOOGLE_SHEET_ID=PASTE_YOUR_GOOGLE_SHEET_ID_HERE
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Email (Gmail app password) - needed for payment QR and confirmation emails
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
EMAIL_FROM_NAME=GeneSysPH Events

# Meeting & Audio Translator (Google Gemini, free tier)
# Get a free key at https://aistudio.google.com/apikey (no credit card needed).
# Free-tier audio may be used by Google to improve its products; enable billing
# on the key's project if your trainings are confidential.
GEMINI_API_KEY=
# Optional overrides. Each model has its own free quota, so the fallback keeps
# translation going when the primary model's quota runs out.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Requests per minute the browser paces itself to (match your AI Studio limit).
# TRANSLATOR_MAX_RPM=8
